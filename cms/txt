
<?php
require_once __DIR__ . '/php/database.php';

// Helper function to render step headers and formatted data
function outputStep(string $title, mixed $data): void
{
    echo "<h3 style='margin-bottom: 5px; color: #2b579a;'>{$title}</h3>";
    echo "<pre style='background: #1e1e1e; color: #d4d4d4; padding: 12px; border-radius: 6px; overflow-x: auto;'>";
    echo is_bool($data) ? ($data ? 'true (Success)' : 'false (Failed)') : htmlspecialchars(json_encode($data, JSON_PRETTY_PRINT));
    echo "</pre><hr style='border: 0; border-top: 1px solid #ccc; margin: 20px 0;'>";
}

echo "<h1 style='font-family: sans-serif;'>PHP JSON Database Operations Demo</h1>";

// ------------------------------------------------------------------
// 1. INITIALIZE ENGINE & SELECT DATABASE FOLDER
// ------------------------------------------------------------------
$db = new Database(__DIR__ . '/storage');

// Create/set active database folder (storage/demo_db)
$db->useDatabase('demo_db');
outputStep("1. Database Selected", "Active database folder set to 'demo_db'");

// ------------------------------------------------------------------
// 2. CREATE TABLE (users.json)
// ------------------------------------------------------------------
$tableCreated = $db->createTable('users');
outputStep("2. createTable('users')", $tableCreated);

// ------------------------------------------------------------------
// 3. INSERT RECORDS
// ------------------------------------------------------------------
$user1 = $db->insert('users', [
    'name'  => 'Alice Johnson',
    'email' => 'alice@example.com',
    'role'  => 'admin'
]);
outputStep("3a. Insert User 1", $user1);

$user2 = $db->insert('users', [
    'name'  => 'Bob Smith',
    'email' => 'bob@example.com',
    'role'  => 'developer'
]);
outputStep("3b. Insert User 2", $user2);

$user3 = $db->insert('users', [
    'name'  => 'Charlie Brown',
    'email' => 'charlie@example.com',
    'role'  => 'developer'
]);
outputStep("3c. Insert User 3", $user3);

// ------------------------------------------------------------------
// 4. SELECT ALL RECORDS
// ------------------------------------------------------------------
$allUsers = $db->select('users');
outputStep("4. select('users') [All Records]", $allUsers);

// ------------------------------------------------------------------
// 5. SELECT WITH WHERE CLAUSE
// ------------------------------------------------------------------
$developers = $db->select('users', ['role' => 'developer']);
outputStep("5. select('users', ['role' => 'developer'])", $developers);

// ------------------------------------------------------------------
// 6. SELECT SINGLE RECORD
// ------------------------------------------------------------------
$singleUser = $db->selectOne('users', ['id' => 1]);
outputStep("6. selectOne('users', ['id' => 1])", $singleUser);

// ------------------------------------------------------------------
// 7. FUZZY SEARCH
// ------------------------------------------------------------------
$searchResults = $db->search('users', 'Smith', ['name', 'email']);
outputStep("7. search('users', 'Smith', ['name', 'email'])", $searchResults);

// ------------------------------------------------------------------
// 8. UPDATE RECORD
// ------------------------------------------------------------------
$updatedRowsCount = $db->update(
    'users',
    ['role' => 'lead_developer'], // Data to update
    ['id' => 2]                     // Where condition
);
outputStep("8a. update() Rows Affected Count", $updatedRowsCount);

$updatedUser = $db->selectOne('users', ['id' => 2]);
outputStep("8b. Verify Updated User Record", $updatedUser);

// ------------------------------------------------------------------
// 9. DELETE RECORD
// ------------------------------------------------------------------
$deletedRowsCount = $db->delete('users', ['id' => 3]);
outputStep("9a. delete() Rows Affected Count", $deletedRowsCount);

$remainingUsers = $db->select('users');
outputStep("9b. select('users') [After Deletion]", $remainingUsers);

// ------------------------------------------------------------------
// 10. DROP TABLE
// ------------------------------------------------------------------
$tableDropped = $db->dropTable('users');
outputStep("10. dropTable('users')", $tableDropped);

$updatedUser = $db->selectOne('users', ['id' => 2]);
outputStep("8b. Verify Updated User Record", $updatedUser);