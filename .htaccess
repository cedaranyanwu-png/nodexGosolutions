# Apache configuration for NodeX Single Entry Point
RewriteEngine On
RewriteBase /

# Prevent direct access to sensitive MAIN directories and storage files
RewriteRule ^main/(config|core|storage|database|discovery|logs)/ - [F,L,NC]
RewriteRule \.json$ - [F,L,NC]

# Check if requested path is NOT a physical file
RewriteCond %{REQUEST_FILENAME} !-f

# Check if requested path is NOT a physical directory
RewriteCond %{REQUEST_FILENAME} !-d

# Route all incoming HTTP requests to single entry point /index.php
RewriteRule ^ index.php [L,QSA]
