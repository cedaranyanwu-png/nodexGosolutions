# QuickChat Environment Variables Configuration

# General Project Settings
DEBUG=True
SECRET_KEY=quickchat-development-secret-key-change-in-production-2025
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,*

# Database Configuration (Defaults to SQLite for local development; supports MySQL if set)
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# Redis & WebSockets
REDIS_URL=redis://127.0.0.1:6379/0

# Celery Configuration
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# Bachs.io Payment Integration Credentials
BACHS_API_KEY=sandbox_bachs_api_key_12345
BACHS_WEBHOOK_SECRET=sandbox_bachs_webhook_secret_67890
BACHS_API_URL=https://api.bachs.io/v1

# WebRTC STUN/TURN Servers
STUN_SERVER_URL=stun:stun.l.google.com:19302
TURN_SERVER_URL=
TURN_SERVER_USERNAME=
TURN_SERVER_CREDENTIAL=

# Llama CPP / AI Local Model Configuration (Optional)
LLAMA_MODEL_PATH=
